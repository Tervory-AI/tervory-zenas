 log = logging.getLogger("hermes")
 
 DEDUPE_SCORE = 0.97
+
+# Gates 7+8 / t51: kinds that may omit meta.user_id (tenant-wide). Empty by default;
+# products declare their own allowlist when calling with user_id omitted.
+TENANT_WIDE_KINDS: frozenset[str] = frozenset()
+
+
+def _personal_user(meta: dict, user_id: str | None, kind: str) -> str | None:
+    """Stamp / require user_id for personal kinds. Missing user on personal is refused."""
+    if kind in TENANT_WIDE_KINDS:
+        return user_id
+    owner = (user_id or (meta or {}).get("user_id") or (meta or {}).get("user") or "").strip()
+    if not owner:
+        raise HTTPException(422, "verified user is required for personal memory")
+    return owner
+
+
+def _visible_to_user(row: dict, user_id: str | None) -> bool:
+    """SQL/vector post-filter: personal rows only for owner; tenant-wide always (when declared)."""
+    if user_id is None:
+        return True
+    meta = row.get("meta") or {}
+    kind = str(row.get("kind") or "")
+    owner = str(meta.get("user_id") or meta.get("user") or "")
+    if kind in TENANT_WIDE_KINDS and not owner:
+        return True
+    return owner == str(user_id)
+
