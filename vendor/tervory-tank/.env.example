# Names only. Values live in your password manager and are pasted into Coolify's environment panel.
# Optional public dated ATF file URL; set the same value on Tank and Base in Coolify.
BASE_REFERENCE_FILE_URL=
# Every provider account: pay-as-you-go, a hard monthly spend cap, auto-reload off or capped.

# PostgreSQL (the shared store; Tank creates the tank schema on first start)
POSTGRES_USER=tervory
POSTGRES_PASSWORD=
POSTGRES_DB=tervory

# Qdrant (vector store; used by Hermes and the semantic cache later)
QDRANT_API_KEY=

# LiteLLM (the model gateway inside Tank)
LITELLM_MASTER_KEY=

# Provider keys (API keys, never OAuth). OpenAI, Gemini and xAI carry the defaults (litellm/config.yaml); each falls back to the others. Anthropic is optional.
ANTHROPIC_API_KEY=      # console.anthropic.com
OPENAI_API_KEY=         # platform.openai.com
GEMINI_API_KEY=         # aistudio.google.com
XAI_API_KEY=            # console.x.ai
MISTRAL_API_KEY=        # console.mistral.ai (EU-hosted; the eu region's default)
DEEPSEEK_API_KEY=       # platform.deepseek.com (Boston and ZA LiteLLM; tenant allow-list and the SA identifier rule apply)
OPENROUTER_API_KEY=     # openrouter.ai (trying new models before a direct key is worth it)
MOONSHOT_API_KEY=       # platform.moonshot.ai (Kimi; Boston and ZA LiteLLM; tenant allow-list and the SA identifier rule apply)
PERPLEXITY_API_KEY=     # perplexity.ai/settings/api (Agent API presets via LiteLLM only; Market Lab after founder promotion)
HF_INFERENCE_TOKEN=     # huggingface.co/settings/tokens, fine-grained, only "Make calls to Inference Providers" (MODELS-3 open-weight models; LiteLLM only; separate from the training HF_TOKEN)
MINIMAX_API_KEY=        # platform.minimax.io (OpenAI-compatible https://api.minimax.io/v1)
ZAI_API_KEY=            # z.ai manage-apikey (OpenAI-compatible https://api.z.ai/api/paas/v4)
DASHSCOPE_API_KEY=      # Alibaba Model Studio / DashScope (https://dashscope-intl.aliyuncs.com/compatible-mode/v1)
STEPFUN_API_KEY=        # platform.stepfun.ai (https://api.stepfun.ai/v1)
ARCEE_API_KEY=          # api.arcee.ai (https://api.arcee.ai/api/v1)
TINKER_API_KEY=         # thinkingmachines.ai Tinker (key only for now; see litellm maker-direct gap note)
SARVAM_API_KEY=         # docs.sarvam.ai (https://api.sarvam.ai/v1; header api-subscription-key)
ZENAS_OWN_MODEL_KEY=    # dedicated shared key between ZA LiteLLM and the private llama.cpp server; never reuse a provider token

# Optional: Brave Search API key for Base pass 2 (website discovery). Without it, Base falls back to domain guesses.
BRAVE_API_KEY=

# The key the Workspace sends as X-Tank-Key. Agents do not use this.
TANK_API_KEY=

# Platform D6: 07:00 America/Los_Angeles report; unset transport/recipient disables mail.
# Reuse the existing approved SMTP transport. Values belong in Coolify only.
FOUNDER_REPORT_TO=
FOUNDER_REPORT_SMTP_HOST=
FOUNDER_REPORT_SMTP_PORT=
FOUNDER_REPORT_SMTP_USER=
FOUNDER_REPORT_SMTP_PASSWORD=
FOUNDER_REPORT_SMTP_FROM=
# Optional tenant content routing. Reuse the destination Tank's existing approved
# Workspace service-key value only when enabling this connection in Coolify.
# Do not put a homes-only or device-approval key in these settings. Empty disables
# foreign content routing; TANK_API_KEY_ZA keeps its original homes/feeds scope.
TANK_CONTENT_API_KEY_ZA=
TANK_CONTENT_API_KEY_US=

# Optional founder repo reads. Fine-grained token for Tervory-AI/tervory-tank:
# Contents, Pull requests, Checks and Commit statuses: read-only. Founder fills it.
TANK_GITHUB_READ_TOKEN=

# Minimum eligible, explicitly noninteractive requests for provider batch pricing.
TANK_BATCH_MIN=50

# TRAIN-1: optional private dataset export; identifier checks apply in both regions.
HF_TOKEN=
HF_ORG=
# Dedicated header-only credential for the weekly re-test/nightly export jobs.
TRAINING_JOB_KEY=
# GitHub Actions configuration names: TRAINING_TANK_URL and TRAINING_TANK_URL_ZA (variables),
# TRAINING_JOB_KEY (secret). Use a credential-free HTTPS origin for the URL.

# Per-agent Tank keys. One long random string per box, pasted into Coolify only.
# Tank reads TANK_KEY_<AGENT>, hashes it (SHA-256), and stores the hash in tank.agent_keys.
# The agent box receives only its own key. Never log the value. Never commit it.
# The suffix lowercased is the agent id: TANK_KEY_TEMPLATE -> template, TANK_KEY_MARKET_LAB -> market_lab.
TANK_KEY_TEMPLATE=
# Signed product-user assertions reuse each product's existing TANK_KEY_<AGENT>.
# Additional product names; the owning product receives only its matching key.
TANK_KEY_OPLI=
# Optional personal memory; unset/empty is off. Activation is a separate config change.
OPLI_MEMORY_ENABLED=
TANK_KEY_SKALA=
TANK_KEY_WORKSPACE=
# Optional personal memory; unset/empty is off.
WORKSPACE_MEMORY_ENABLED=
# Tiger's key. Tank hashes it. Hermes compares the same value, or it will not recognise Tiger.
TANK_KEY_TIGER=

# Password for the agent's own database role (agent_<name>), not the Postgres superuser.
# Hex only, so it is safe inside a Postgres URL: openssl rand -hex 24
# The agent-roles service reads AGENT_DB_PASSWORD_<AGENT> and creates or updates the role.
# The agent resource gets the same value and nothing else from Postgres. Never log it. Never commit it.
# The suffix lowercased is the agent id: AGENT_DB_PASSWORD_TEMPLATE -> role agent_template.
AGENT_DB_PASSWORD_TEMPLATE=
# Password for role agent_tiger. Hex only: openssl rand -hex 24. Never commit the value.
AGENT_DB_PASSWORD_TIGER=

# Region tag written to every ledger row: us-east | za | eu
# The Boston stack is us-east. The South Africa stack (docker-compose.za.yml) sets za
# in the compose file itself. Do not point that stack at a US host.
TANK_REGION=us-east

# South Africa Tank only. Comma-separated LiteLLM model names that run in South Africa.
# Empty until za-local in litellm/config.za.yaml is filled in. Names only, never a key.
ZA_HOSTED_MODELS=
# Optional narrower allow-list. JSON object of tenant id to model names. No secrets.
# Example shape only: {"00000000-0000-0000-0000-000000000000":["za-local"]}
TANK_PROVIDER_ALLOW=
# Build-only models (build-*, the ChatGPT sign-in) answer only the platform tenant and
# these extra internal test tenants. Comma-separated tenant ids. Never a customer tenant.
# Empty means the platform tenant only. See docs/ops/CHATGPT-BUILD-MODEL.md.
TANK_BUILD_TENANTS=
# Key name for the commented za-local slot. Value stays in Coolify.
ZA_LOCAL_API_KEY=
# Zenas room on THIS server. The /v1/zenas proxy refuses any other host.
ZENAS_AGENT_URL=http://agent-zenas:8000
# Per box. off (the default): a rule card that passes cite-check is active, and a
# memo goes to the matter with reviewed false. on: the review queue stays in front.
# Set it on the US box and the ZA box separately. No secret.
ZENAS_REVIEW=off
# How many decided cases one conversion reads. Default 200 when this is unset. Name only.
ZENAS_CONVERT_MAX=200
# Agents: how long a background (priority=batch) Tank call waits for its queued
# job, in seconds. Default 90000 (the 24h provider batch window plus an hour). No secret.
TANK_BACKGROUND_WAIT_S=90000
# Nightly conversion: how many case_facts calls wait in Tank's batch queue at once.
# Default 50. Set 1 to restore one-at-a-time calls. No secret.
ZENAS_CONVERT_PARALLEL=50
# Workspace only, founder home setting: the ZA Tank (HTTPS) and the ZA Tank's homes-only key
# (the value of TANK_HOMES_KEY on the ZA Tank; never the ZA TANK_API_KEY).
# Only a tenant id and a region code are sent. Names only here.
TANK_URL_ZA=
TANK_API_KEY_ZA=
# ZA Tank only: a key that can call POST /v1/zenas/tenants with home za and nothing else.
TANK_HOMES_KEY=
# Trigger sign-in own-session list/revoke capability. It cannot approve devices
# or mint credentials. The native token, tenant, subject and issuer remain verified.
# Set the ZA value on Tank and the matching _ZA name on the Boston Workspace.
# Keep it distinct from the Workspace and homes keys. Names only.
TRIGGER_SIGNIN_SESSIONS_KEY=

# Daily cap, in dollars, on paid shadow and search calls for one task type.
# Code skills are not capped. Default is 1 when this is unset.
TANK_SHADOW_BUDGET_USD=1

# Workspace (served publicly by Coolify on port 3000)

# Stripe billing. Workspace server only. Paste values in Coolify. Never commit a value.
# The browser does not receive the secret. Amounts on the billing page are read from Stripe.
# STRIPE_PLAN_PRICE_IDS is a comma-separated list of Price ids, in display order. No value here.
# BILLING_PUBLIC_ORIGIN is optional (https://app.tervory.com). Empty uses the request host for Checkout return links.
# STRIPE_WEBHOOK_SECRET verifies the Stripe webhook signature. Name only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLAN_PRICE_IDS=
BILLING_PUBLIC_ORIGIN=


# Self-hosted search (SearXNG). Any long random string; internal only.
SEARXNG_SECRET=

# Market Lab feed keys. This is the list. Paste values in Coolify on the Market Lab
# resource (agents/market_lab/docker-compose.yml passes each name through). Never in git.
# A feed stays off until its variable is non-empty: it is not called, and status
# reads off / needs key. Nothing in the app asks for a key.
# FRED is read live and is not stored (the API terms forbid a database copy).
# NOAA_TOKEN is NCEI climate only. NWS weather alerts need no key.
LEGISCAN_API_KEY=       # https://legiscan.com/legiscan  (public API, CC BY 4.0)
CENSUS_API_KEY=         # https://api.census.gov/data/key_signup.html
FRED_API_KEY=           # https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=            # https://www.eia.gov/opendata/register.php
NOAA_TOKEN=             # https://www.ncdc.noaa.gov/cdo-web/token  (NCEI). NWS alerts need none.
FEEDS_DATABASE_URL=     # sqlite file for the feeds runner, e.g. sqlite:///feeds.sqlite. Postgres: apply agents/market_lab/feeds/schema.sql with the platform tools.
USPTO_API_KEY=          # https://data.uspto.gov/ — name only; the USPTO feed remains disabled.


# Hermes (C7). Shared memory in the main stack. Internal only: no public domain.
# Hermes reads the same TANK_KEY_<AGENT> names as Tank and compares SHA-256 hashes. Key checks do not read the database. Memory records use the existing same-box DATABASE_URL; no new credential is introduced.
# Agents call Hermes at http://hermes:8000. They do not call Qdrant. QDRANT_API_KEY above is what Hermes uses on the main network.
# A later agent task attaches tervory-gw-<agent> to the hermes service and passes that agent's TANK_KEY_<AGENT> into it.
# The embedding model runs inside the Hermes container. No provider key. Client text stays on this server.
# The image already contains BAAI/bge-small-en-v1.5. Set this only to pin the same name.
HERMES_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Market Lab box (C9). Own corridor tervory-gw-market_lab, role agent_market_lab.
# Tank and Hermes both need TANK_KEY_MARKET_LAB. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
TANK_KEY_MARKET_LAB=
AGENT_DB_PASSWORD_MARKET_LAB=

# Radix (C10). Security auditor. Corridor tervory-gw-radix is an internal network
# (docker network create --internal tervory-gw-radix): Tank, Postgres, and Hermes only.
# TANK_KEY_RADIX goes on Tank and on Hermes. Hex password: openssl rand -hex 24.
# RADIX_ALLOWED_HOSTS stays empty. Radix refuses every other host until an egress proxy exists.
TANK_KEY_RADIX=
AGENT_DB_PASSWORD_RADIX=
RADIX_ALLOWED_HOSTS=

# Tisan (C10). Developer and designer. Corridor tervory-gw-tisan.
# TANK_KEY_TISAN goes on Tank and on Hermes. Hex password: openssl rand -hex 24.
TANK_KEY_TISAN=
AGENT_DB_PASSWORD_TISAN=
# Tisan Figma reader: founder token, sent only through the api.figma.com proxy. Name only.
FIGMA_TOKEN=
# Tenant/file allowlist: comma-separated <tenant id>=<file key> pairs. Name only.
TISAN_FIGMA_FILES=

# Base room (B3). Own corridor tervory-gw-base, role agent_base.
# Tank and Hermes both need TANK_KEY_BASE. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
# Base reaches Tiger's browser and SearXNG on this corridor. It does not hold provider keys.
TANK_KEY_BASE=
AGENT_DB_PASSWORD_BASE=

# Zenas box (Z1). Own corridor tervory-gw-zenas, role agent_zenas.
# Tank and Hermes both need TANK_KEY_ZENAS. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
# ZENAS_PII_KEY encrypts personal identifiers in the Zenas box. Exactly 32 bytes, hex: openssl rand -hex 32.
TANK_KEY_ZENAS=
AGENT_DB_PASSWORD_ZENAS=
ZENAS_PII_KEY=
# Optional on each box; normal deployments exclude the brain profile as well.
ZENAS_BRAIN_ENABLED=false
# Distinct value on each box, shared only by that box's Zenas brain and sandbox.
SANDBOX_KEY_ZENAS=
# Worked matters from a client's released files. region (the default) shares them with
# other tenants in the same region only. tenant keeps them private to the owner.
# Decided cases are public either way. Drafts and unreleased files are never shared.
# Nothing is copied to the other region.
ZENAS_MATTER_SHARING=region

# Zenas knowledge pool. Names only. Paste values in Coolify for the pool-loader, never in git.
# A keyed source is skipped until its variable is set. The value is never put in a URL, a log, or a test.
COURTLISTENER_API_TOKEN=   # https://www.courtlistener.com/help/api/rest/  (header Authorization: Token, not a query parameter)
GOVINFO_API_KEY=           # https://api.govinfo.gov/docs/  (header X-Api-Key). Optional: house.gov USLM is used when this is empty.
NY_OPENLEG_API_KEY=        # https://legislation.nysenate.gov/  New York Open Legislation. Not placed in a URL.
POOL_DISK_CAP_BYTES=       # optional byte cap for the pool on this box. Default 42949672960 (40 GiB).
COURTLISTENER_MIN_INTERVAL=12
COURTLISTENER_HOURLY_MAX=45
COURTLISTENER_DAILY_MAX=100
POOL_LOAD=                 # set to 1 only when starting pool-loader for one wave. Empty keeps the service idle.
LAWS_AFRICA_API_TOKEN=     # https://api.laws.africa/v3/  (header Authorization: Bearer). ZA box only. Never put it in a URL.
SAFLII_MIN_INTERVAL=       # optional seconds between SAFLII page fetches. Default 1. Live SAFLII load is deferred.
GOVZA_MAX_NOTICES=         # optional cap on gov.za notice pages per wave. Default 10. Keyless. ZA box only.
GOVZA_MIN_INTERVAL=        # optional seconds between gov.za fetches. Default 0. Use 1 on the ZA box.
CONCOURT_MIN_INTERVAL=     # seconds between Constitutional Court OAI/REST calls. Default 10.
CONCOURT_MAX_ITEMS=        # Latest Judgments items per wave. Default 5. Keyless.
ZA_CASE_MIN_INTERVAL=      # seconds between other keyless ZA case fetches. Default 1.
ZA_CASE_MAX_DOCS=          # documents per keyless ZA case source per wave. Default 8.
SCA_MAX_YEARS=             # SCA and Electoral Court year folders per wave. Default 1.
SCA_MAX_PAGES=             # jDownloads pages per year (?start= steps of 10). Default 1.

# Rig (R3). Public API at rig.tervory.com. Corridor tervory-gw-rig, role agent_rig.
# Tank and Hermes both need TANK_KEY_RIG. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
TANK_KEY_RIG=
# RIG-3: retailer controls only. Share between Tank and agent-rig, never a brain or gateway.
RIG_RETAILER_KEY=
# Existing Rig SMTP transport: STARTTLS, used for reservations and quote delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AGENT_DB_PASSWORD_RIG=
# RIG-2: separate executor credential; only rig-brain and rig-sandbox receive it.
SANDBOX_KEY_RIG=
# Optional Rig worker and personal memory remain disabled when unset.
RIG_BRAIN_ENABLED=
RIG_MEMORY_ENABLED=
# Private origin is validated by Tank; empty uses the existing rig-brain service.
RIG_BRAIN_URL=
# TG3: Tiger brain stays off pending the dated Boston capacity report.
TIGER_BRAIN_ENABLED=false
# Tiger-only executor credential; coolify-ops room-setup room=tiger names=SANDBOX_KEY_TIGER.
# Only tiger-brain and tiger-sandbox receive it. The founder supplies values.
SANDBOX_KEY_TIGER=
# Days of finished searches Rig reuses, and how long a saved search is kept.
# Empty means 90. The nightly clean-up uses the same number.
RIG_SEARCH_RECALL_DAYS=

# RIG-4: exact tenant UUID -> sender and optional HTTPS portal_url.
# Configure in the room only. Real shopper data is connected last.
RIG_QUOTE_FLOWS=
# Publishable embed key only, restricted to the retailer and test-page origins.
RIG_WIDGET_PUBLISHABLE_KEY=
# Exact trusted ingress proxy IPs/CIDRs, comma-separated. Empty ignores forwarded headers.
RIG_TRUSTED_PROXY_CIDRS=
# Quote/contact retention in days, default 30, allowed 1–365. Purged every five minutes.
RIG_QUOTE_RETENTION_DAYS=

# Optional cross-store fulfilment (Locate checkout). Each store switches it on
# itself (retailers.locate_enabled, off by default). Names only, founder fills values.
# Signs the short-lived confirm hold. At least 32 characters. Empty refuses confirm.
RIG_LOCATE_HOLD_SECRET=
# Hold lifetime in seconds, default 600, allowed 60-900.
RIG_LOCATE_HOLD_SECONDS=
# Must be exactly "sandbox" or Locate records no order. Orders live in Rig's own database.
RIG_LOCATE_ORDER_MODE=
# Tiger one-shot live check (POST /rig/check-now). Same key value in Rig and Tiger.
RIG_TIGER_URL=
RIG_TIGER_CHECK_KEY=
# Approved-source stock API, one pair per source id upper-cased (example name only):
# RIG_SUPPLY_API_URL_<SOURCE>= and RIG_SUPPLY_API_KEY_<SOURCE>=

# RX-5 optional source credentials, read by name in Tank. No outbound lookup.
# Leave unset: keyed evidence is skipped. These names do not enable a vault.
RADIX_SOURCE_CIPC_KEY=
RADIX_SOURCE_REGISTER_KEY=

# WORKERS-1. The workers service runs on the Boston host as user tervory-workers, not in Coolify.
# Its settings live in /etc/tervory-workers/worker.env (template: workers/host/worker.env.example).
# Tank needs the same TANK_KEY_WORKERS value so the ledger agent is "workers". openssl rand -hex 32
TANK_KEY_WORKERS=

# Maximum automatic gold candidates per source per night (default 200).
GOLD_AUTO_MAX=

# Maximum estimated HF training cost per job, USD (default 50).
HF_TRAIN_MAX_USD=

# Base company-data trial credential; set only in the Base room.
CONTEXT_DEV_API_KEY=
# Base trial credit ceiling per run (default 500).
CONTEXT_DEV_MAX_CREDITS=

# BUCKET-1: scoped R2 pairs, configured only on their owning Coolify app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID_BASE=
R2_SECRET_ACCESS_KEY_BASE=
R2_ACCESS_KEY_ID_TIGER=
R2_SECRET_ACCESS_KEY_TIGER=
R2_ACCESS_KEY_ID_MARKET_LAB=
R2_SECRET_ACCESS_KEY_MARKET_LAB=
R2_ACCESS_KEY_ID_RADIX=
R2_SECRET_ACCESS_KEY_RADIX=
R2_ACCESS_KEY_ID_TISAN=
R2_SECRET_ACCESS_KEY_TISAN=
R2_ACCESS_KEY_ID_RIG=
R2_SECRET_ACCESS_KEY_RIG=
R2_ACCESS_KEY_ID_ZENAS=
R2_SECRET_ACCESS_KEY_ZENAS=
R2_ACCESS_KEY_ID_GHOST=
R2_SECRET_ACCESS_KEY_GHOST=
R2_ACCESS_KEY_ID_UPLOADS=
R2_SECRET_ACCESS_KEY_UPLOADS=
# Public age recipient for encrypted backups; private restore key stays offline.
R2_BACKUP_RECIPIENT=
# r2-backup also uses QDRANT_URL and QDRANT_API_KEY (names above) for Qdrant snapshots.

# CORE-1 daily platform bench limit in USD; defaults to 5. Set 0 to pause.
TANK_BENCH_MAX_USD=

# GHOST-1: room setup provisions these names; no values belong in source.
# The role is reserved; Ghost receives no production database login.
AGENT_DB_PASSWORD_GHOST=
TANK_KEY_GHOST=
# GHOST-2 only: Coolify token with read and deploy permissions; not wired in phase 1.
COOLIFY_TOKEN_GHOST_ACTIONS=
# GHOST-2 inventory: a separate READ-ONLY Coolify API token for agent-ghost (never the actions token).
COOLIFY_TOKEN_GHOST=
# Optional plain https base URL of Coolify for that token; defaults to https://coolify.tervory.com.
COOLIFY_URL_GHOST=
# Autumbra air gap: Watch has NO edge write credential.
# Edge secret NAME held until a real connected edge client (agnostic; no CF name yet).
# Reserved Enforce env (value injected per project; never commit values):
AUTUMBRA_EDGE_CREDENTIAL=
# Signed inbound webhooks — agnostic names only (no AUTUMBRA_CF_* until a real CF client).
# Optional only when a client connects an edge / mailbox hand:
AUTUMBRA_EDGE_WEBHOOK_SECRET=
# Signed owner-email Undo + receipts links (tenant + shield). openssl rand -hex 32.
# Same value on Workspace, Watch (agent-ghost), and each Enforce container (Coolify secret NAME).
# Unset → signing fails closed; emails must not promise one-tap Undo.
AUTUMBRA_UNDO_TOKEN_SECRET=
AUTUMBRA_MAILBOX_WEBHOOK_SECRET=
# Per-client Enforce process (ghost.enforce_app) — names only; Coolify injects values:
# TENANT_ID: client UUID for this Enforce room (modes loaded from DATA_DIR store).
TENANT_ID=
# SITE_NAME: client site label stamped on Enforce receipts when store site is empty.
SITE_NAME=
# AUTUMBRA_ROLE: must be "enforce" inside the Enforce container (isolation probe).
AUTUMBRA_ROLE=
# THREAT_PAYLOAD_QUEUE_ROOT: Watch-side root; each client queue is <root>/<tenant_id>.
THREAT_PAYLOAD_QUEUE_ROOT=
# THREAT_PAYLOAD_QUEUE: Enforce-side path for THIS client's queue volume mount.
THREAT_PAYLOAD_QUEUE=
# THREAT_PAYLOAD_QUEUE_VOLUME: Coolify/compose volume name for the per-client queue mount.
THREAT_PAYLOAD_QUEUE_VOLUME=
# ENFORCE_DRAIN_INTERVAL_SEC: Enforce background drain loop tick (default 1.0).
ENFORCE_DRAIN_INTERVAL_SEC=
# ENFORCE_NETWORK_NAME: docker network name for this client's internal Enforce net.
ENFORCE_NETWORK_NAME=
# ENFORCE_HOST / ENFORCE_PORT: bind address for `python -m ghost.enforce_app` locally.
ENFORCE_HOST=
ENFORCE_PORT=
# AUTUMBRA_ENFORCE_DROP_TANK_KEY: set to 1 in dogfood to prove Enforce boots without TANK_KEY.
AUTUMBRA_ENFORCE_DROP_TANK_KEY=
# AUTUMBRA_FIXTURE_COMPOSE_ROOT: local root for FixtureComposeBackend create/destroy tests.
AUTUMBRA_FIXTURE_COMPOSE_ROOT=

# DATA_DIR: persistent store path for Watch (ghost.sqlite3) and Enforce (autumbra_enforce.sqlite3).
DATA_DIR=
# AUTUMBRA_HF_LIVE: set to 1 only after founder tops up HF and says go (dogfood only; default off).
AUTUMBRA_HF_LIVE=
# Dual-LLM guard flags (default OFF — ThreatPayload burn unchanged when unset):
GHOST_GUARDRAILS_ENABLED=
AUTUMBRA_GUARDRAILS_ENABLED=
AUTUMBRA_OSS_GUARD=
# Optional OSS Watch / Enforce routes (default OFF → 404):
WATCH_OSS_ENABLED=
GHOST_WATCH_OSS_ENABLED=
ENFORCE_OSS_ENABLED=
GHOST_ENFORCE_OSS_ENABLED=
ENFORCE_OSS_ARMED=
# AUTUMBRA_OSS_VAULT: local vault path for OSS handoff receipts (dogfood).
AUTUMBRA_OSS_VAULT=

# ACCESS-1. Generate 32 random bytes, URL-safe base64, in Coolify; never paste values here.
# Tank only: encrypts connection credentials at rest.
TANK_VAULT_KEY=
# One separate key per room, shared ONLY by Tank and that room's browser container.
ACCESS_BROWSER_KEY_BASE=
ACCESS_BROWSER_KEY_TIGER=
# Meta public-business API stays off until app review is explicitly approved.
META_APP_ID=
META_APP_REVIEW_APPROVED=
META_ACCESS_TOKEN=
# API version approved for the Meta app (for example, the version in its review).
META_GRAPH_VERSION=
# App-owned Instagram business account for official business discovery; no personal accounts.
META_IG_BUSINESS_ID=

# Existing Tiger /data volume name; required to preserve data in raw Compose mode.

# RIG-5F: job-scoped Hugging Face credential, held only by rig-forge.
HF_JOBS_TOKEN=
# Hugging Face account/organization that owns Rig GPU jobs.
HF_JOBS_NAMESPACE=

# RIG-5F: TRELLIS remains off until the founder resolves NVIDIA/DINOv3 licences.
# (RIG_FORGE_TRELLIS_ENABLED is defined once below, default false.)
# Finished-job diagnostic retention in seconds (default seven days); pending receipts persist.
FORGE_RETENTION_SECONDS=

# Optional Rig 3D add-on price; founder sets it. Empty means Not available yet.
RIG_3D_PRICE_ID=
# Few-photo preparation stays disabled until explicitly enabled on Rig, brain and forge.
RIG_FORGE_TRELLIS_ENABLED=false

# Tiger alert email; agent-tiger only. Grok creates names, founder supplies values.
# STARTTLS transport reuses Rig's SmtpMailer with Tiger's own configuration.
TIGER_SMTP_HOST=
TIGER_SMTP_PORT=
TIGER_SMTP_USER=
TIGER_SMTP_PASSWORD=
TIGER_SMTP_FROM=
# JSON object: exact tenant UUID -> that tenant's alert email address. No default.
TIGER_SMTP_ALERT_ADDRESSES=
# Optional local CPU checkpoint location; baked into Tank's image at this path.
# No Hugging Face token or provider key is required by RouteLLM.
TANK_ROUTELLM_PATH=/opt/routellm

# Trigger room: founder fills values in Coolify; Grok provisions agent-trigger.
TANK_KEY_TRIGGER=
AGENT_DB_PASSWORD_TRIGGER=


# Zenas regulation alerts: region-local SMTP; exact tenant UUID -> recipient JSON.
# No wildcard/default recipient. Missing configuration keeps delivery pending.
CONGRESS_GOV_API_KEY=
ZENAS_SMTP_HOST=
ZENAS_SMTP_PORT=
ZENAS_SMTP_USER=
ZENAS_SMTP_PASSWORD=
ZENAS_SMTP_FROM=
ZENAS_SMTP_ALERT_ADDRESSES=
# LEGISCAN_API_KEY is declared above; unset keeps the LegiScan connector off.

# Tisan site promotion: founder supplies the API origin and token in Coolify.
# Use an API token without read:sensitive; never expose values in logs or the browser.
TISAN_COOLIFY_URL=
TISAN_COOLIFY_TOKEN=
# Tisan publish, on Tank (Boston): the private sites repository (owner/name) and a fine-grained
# token for that one repository only, Contents and Workflows read/write. Names only here.
TISAN_SITES_REPO=
TISAN_GITHUB_TOKEN=

# Opt-in RLS rollout: separate BYPASSRLS account; founder supplies connection values.
TANK_ADMIN_DATABASE_URL=
TANK_RLS_ADMIN_ROLE=
CHASSIS_ADMIN_DATABASE_URL=
CHASSIS_RLS_ADMIN_ROLE=
# Optional dedicated Radix gateway maintenance login; grant only Radix passive-scan maintenance.
RADIX_GATEWAY_ADMIN_DATABASE_URL=
RADIX_GATEWAY_RLS_ADMIN_ROLE=

# Autumbra Enforce only (never Watch). Founder supplies the zone-scoped value.
# Activation also requires the fixed API proxy and configured signed health observer.
CLOUDFLARE_API_TOKEN_ENFORCE=

# Trigger CRM connector: founder fills values in Coolify only. Never paste a PAT here.
# Bind an actual Tank tenant UUID to its actual BottleCRM org UUID and token setting NAME.
# Bindings JSON fields: token_env (TRIGGER_CRM_PAT_CONNECTOR), organization_id.
# No guessed/default mapping; missing/duplicate mappings fail closed.
TRIGGER_CRM_URL=
TRIGGER_CRM_TENANT_BINDINGS=
TRIGGER_CRM_PAT_CONNECTOR=

# Trigger B1 hand-over recipients, a tenant UUID -> email JSON map.
# Founder supplies the value in Coolify. Uses the existing SMTP_* sender above.
TRIGGER_BOT_HANDOVER_ADDRESSES=
# Trigger sign-in: one Boston resource and issuer for all work regions.
# Generated by deployment; never copied into Coolify by hand.
TRIGGER_SIGNIN_ISSUER=
TRIGGER_SIGNIN_CLIENT_ID=
TRIGGER_SIGNIN_WORKSPACE_CLIENT_ID=
TRIGGER_SIGNIN_PROJECT_ID=
# Secrets: founder enters values only in Coolify, never in git.
TRIGGER_SIGNIN_WORKSPACE_SECRET=
TRIGGER_SIGNIN_DIRECTORY_TOKEN=
TRIGGER_SIGNIN_SETUP_TOKEN=
TRIGGER_SIGNIN_CONFIG_TOKEN=
TRIGGER_SIGNIN_MACHINE_TOKEN=
TRIGGER_SIGNIN_REVIEWERS=
# Trigger sign-in resource only: founder enters all values in Coolify, never in git.
# Immutable exactly 32 ASCII characters; retain securely with encrypted backups.
TRIGGER_SIGNIN_MASTERKEY=
TRIGGER_SIGNIN_SESSION_COOKIE_SECRET=
TRIGGER_SIGNIN_POSTGRES_ADMIN_PASSWORD=
TRIGGER_SIGNIN_DB_PASSWORD=
TRIGGER_SIGNIN_ADMIN_EMAIL=
TRIGGER_SIGNIN_ADMIN_TEMP_PASSWORD=
TRIGGER_SIGNIN_BOOTSTRAP_KEY_EXPIRATION=
TRIGGER_SIGNIN_LOGIN_CLIENT_PAT_EXPIRATION=
TRIGGER_SIGNIN_PROXY_NETWORK=

# ML3: Market Lab's existing SMTP sender. Founder fills values in Coolify.
# ALERT_ADDRESSES maps exact tenant UUIDs to recipients; no default recipient.
MARKET_LAB_SMTP_HOST=
MARKET_LAB_SMTP_PORT=
MARKET_LAB_SMTP_USER=
MARKET_LAB_SMTP_PASSWORD=
MARKET_LAB_SMTP_FROM=
MARKET_LAB_SMTP_ALERT_ADDRESSES=

# Autumbra Watch only: founder enters values in Coolify; absent SMTP uses fixture.
AUTUMBRA_SMTP_HOST=
AUTUMBRA_SMTP_PORT=
AUTUMBRA_SMTP_FROM=
AUTUMBRA_SMTP_USER=
AUTUMBRA_SMTP_PASSWORD=
AUTUMBRA_CLOUDFLARE_WEBHOOK_SECRET=
AUTUMBRA_GOOGLE_PUSH_AUDIENCE=
AUTUMBRA_GOOGLE_PUSH_SERVICE_ACCOUNT=

# Specific Workspace/platform proxy networks trusted for public bot visitor limits.
TRIGGER_BOT_TRUSTED_PROXY_CIDRS=
# Trigger M1 GBP: founder-owned Google Cloud OAuth web client. Names only.
# Founder supplies values in Coolify after Google's GBP API access approval.
TRIGGER_GOOGLE_OAUTH_CLIENT_ID=
TRIGGER_GOOGLE_OAUTH_CLIENT_SECRET=
# Trigger M2: founder registers the Meta app and fills values only in Coolify.
TRIGGER_META_APP_ID=
TRIGGER_META_APP_SECRET=
# Trigger B3: founder supplies WhatsApp app settings and per-number bindings in Coolify.
# Each binding: tenant_id, token_env (TRIGGER_WHATSAPP_TOKEN_<NAME>), timezone (account IANA zone).
# Missing/invalid timezone means hand-over email only; never a WhatsApp reply.
TRIGGER_WHATSAPP_BINDINGS=
TRIGGER_WHATSAPP_APP_SECRET=
TRIGGER_WHATSAPP_VERIFY_TOKEN=
# Server-only token slot selected by token_env; founder supplies its value.
TRIGGER_WHATSAPP_TOKEN_CONNECTOR=

# Autumbra health signing: founder sets the same value in Enforce and its observer.
# Name only; never set in Watch or either proxy.
AUTUMBRA_HEALTH_SECRET=

# Autumbra Enforce lifecycle: dedicated Enforce-only Coolify team and test host.
# Reserved for isolated enforce-lifecycle only; token read/write/deploy for DELETE, no root or read:sensitive.
AUTUMBRA_COOLIFY_URL=
AUTUMBRA_COOLIFY_TOKEN=
AUTUMBRA_COOLIFY_PROJECT_UUID=
AUTUMBRA_COOLIFY_SERVER_UUID=
AUTUMBRA_COOLIFY_ENVIRONMENT=
AUTUMBRA_COOLIFY_GITHUB_APP_UUID=

# Existing Autumbra draft-only dogfood PR path; founder fills the existing repo-scoped setting.
GHOST_PATCH_PR_ENABLED=0
GHOST_GITHUB_TOKEN=

# Lifecycle request HMAC: Tank and enforce-lifecycle only; never Watch or browser.
AUTUMBRA_LIFECYCLE_KEY=

# I6 GitHub Actions: RADIX_DEPLOY_TENANT_ID repository variable identifies the founder workspace.
# deploy-on-merge reuses the existing TANK_API_KEY repository secret for its fixed-host gate read.
# The script-local RADIX_DEPLOY_TANK_KEY name is not a new Coolify setting or provider key.
# Per-client Enforce and health observer only; HTTPS path on the approved SITE_NAME.
AUTUMBRA_HEALTH_URL=

# CLI tag releases: GitHub Actions secret, not a Coolify runtime setting.
# Ed25519 PKCS#8 PEM; referenced by name only. Never commit a value.
CLI_RELEASE_SIGNING_KEY=
# Matching SPKI PEM in a GitHub repository variable; distribute independently.
CLI_RELEASE_SIGNING_PUBLIC_KEY=

# market-lab optional standby brain; leave profile brain disabled until founder capacity approval.
MARKET_LAB_BRAIN_ENABLED=false
# Owning executor key name only; separate from all other rooms.
SANDBOX_KEY_MARKET_LAB=

# radix optional standby brain; leave profile brain disabled until founder capacity approval.
RADIX_BRAIN_ENABLED=false
# Optional personal memory remains disabled when unset.
RADIX_MEMORY_ENABLED=
# Owning executor key name only; separate from all other rooms.
SANDBOX_KEY_RADIX=

# tisan optional standby brain; leave profile brain disabled until founder capacity approval.
TISAN_BRAIN_ENABLED=false
# Owning executor key name only; separate from all other rooms.
SANDBOX_KEY_TISAN=

# trigger optional standby brain; leave profile brain disabled until founder capacity approval.
TRIGGER_BRAIN_ENABLED=false
# Optional personal memory; unset/empty is off.
TRIGGER_MEMORY_ENABLED=
# Owning executor key name only; separate from all other rooms.
SANDBOX_KEY_TRIGGER=

# ghost optional standby brain; leave profile brain disabled until founder capacity approval.
GHOST_BRAIN_ENABLED=false
# Owning executor key name only; separate from all other rooms.
SANDBOX_KEY_GHOST=
# BEGIN mobile
# Mobile push: names only; provision server-side, never in Workspace or app bundles.
MOBILE_APNS_KEY=
MOBILE_APNS_KEY_ID=
MOBILE_APNS_TEAM_ID=
MOBILE_APNS_ENVIRONMENT=
MOBILE_FCM_SERVICE_ACCOUNT_JSON=
MOBILE_APPLE_TEAM_ID=
MOBILE_ANDROID_CERT_SHA256=
# END mobile

# Rig rooms: Coolify settings only on enforce-lifecycle; lifecycle key on Tank too.
# Dedicated Rig team token: read/write/deploy, no root or read:sensitive.
RIG_COOLIFY_URL=
RIG_COOLIFY_TOKEN=
RIG_COOLIFY_PROJECT_UUID=
RIG_COOLIFY_SERVER_UUID=
RIG_COOLIFY_ENVIRONMENT=
RIG_COOLIFY_GITHUB_APP_UUID=
RIG_LIFECYCLE_KEY=
RIG_ROOM_DB_PASSWORD=
# RIG_ROOM_DB_PASSWORD is unique per store application, never on shared Rig.
# Engine cache layers: unset/0 is off; only 1 enables a layer.
# C1: Tank and LiteLLM; C4: Tank and Hermes; I8: Tank.
ENGINE_C1_ENABLED=
ENGINE_C4_ENABLED=
ENGINE_I8_ENABLED=
# BEGIN engine observability
# DECISION leave engine endpoints unset on Boston and ZA. Only owned servers enable
# the engine compose profile and set these endpoints. Never send credentials to clients.
# Stage 2 identical-error stop. Blank preserves the current code path; founder opt-in is literal true.
ENGINE_CODE_GATE_ENABLED=
# Stage 2 progress evidence; also requires ENGINE_CODE_GATE_ENABLED=true. Blank preserves main.
ENGINE_CODE_PROGRESS_ENABLED=
# Model URLs are OpenAI-compatible bases; ENGINE_LOCAL_URL gates both local rungs.
ENGINE_LOCAL_URL=
ENGINE_LARGE_URL=
# Stage 4 tool payload bounds. Literal true opts in; blank preserves current main.
ENGINE_CODE_TOOL_LIMITS_ENABLED=
# An unset host disables all trace hooks, project validation and outbox workers.
LANGFUSE_HOST=
LANGFUSE_ENABLED=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_S3_ACCESS_KEY_ID=
LANGFUSE_S3_SECRET_ACCESS_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_UI_URL=
# LiteLLM and Tank's native-batch exporter: tenant UUID -> {project_id,public_key,secret_key}.
# Create a distinct self-hosted project for every tenant, including PLATFORM_TENANT.
LANGFUSE_TENANT_PROJECTS=
# Tank only: JSON tenant UUID -> project_id; contains no API keys.
LANGFUSE_TENANT_PROJECT_IDS=
# END engine observability
